from ament_nodl.testing import conformance_test

_PACKAGE = @_package_python@
_EXECUTABLE = @_executable_python@
_NODL_FILE = @_nodl_file_python@
_NODE_NAME = @_node_name_python@
_NODE_NAMESPACE = @_node_namespace_python@
_TIMEOUT = @_ARGS_TIMEOUT@
_PARAMETERS_FILES = [@_parameters_files_python@]
_PARAMETERS = [@_parameters_python@]
_IGNORE = @_ignore_python@

generate_test_description, TestNodlConformance = conformance_test(
    package=_PACKAGE,
    executable=_EXECUTABLE,
    nodl=_NODL_FILE,
    node_name=_NODE_NAME,
    node_namespace=_NODE_NAMESPACE,
    timeout=_TIMEOUT,
    parameters=_PARAMETERS,
    parameters_files=_PARAMETERS_FILES,
    ignore=_IGNORE,
)
