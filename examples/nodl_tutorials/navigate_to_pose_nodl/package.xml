<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navigate_to_pose_nodl</name>
  <version>2.0.3</version>
  <description>Conventional and NoDL-backed clients used by the incremental Nav2 migration tutorial.</description>
  <maintainer email="rosgraph-wg@googlegroups.com">ROSGraph Working Group</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>ament_nodl</buildtool_depend>
  <buildtool_depend>nodl_generator_cpp</buildtool_depend>
  <buildtool_depend>nodl_generator_py</buildtool_depend>

  <build_depend>nodl_common_interfaces</build_depend>

  <depend>action_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclpy</depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>ros2nodl</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
