# generated from nodl_generator_py/nodl_generator_py-extras.cmake.in

get_filename_component(_nodl_generator_py_install_dir
  "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

set(_nodl_generator_py_script
  "${_nodl_generator_py_install_dir}/lib/nodl_generator_py/nodl_generate_py")
set(_nodl_generator_py_templates_dir
  "${_nodl_generator_py_install_dir}/share/nodl_generator_py/templates")

find_package(Python3 REQUIRED COMPONENTS Interpreter)
find_package(ament_cmake_python REQUIRED)
find_package(generate_parameter_library REQUIRED)
ament_get_python_install_dir(_nodl_python_install_dir)
string(CONCAT _nodl_generator_py_module
  "${_nodl_generator_py_install_dir}/${_nodl_python_install_dir}"
  "/nodl_generator_py/generator.py")

set(_nodl_pythonpath_dirs "")
set(_nodl_search_prefixes ${CMAKE_PREFIX_PATH})
if(DEFINED ENV{AMENT_PREFIX_PATH})
  string(REPLACE ":" ";" _ament_prefixes "$ENV{AMENT_PREFIX_PATH}")
  list(APPEND _nodl_search_prefixes ${_ament_prefixes})
endif()
list(REMOVE_DUPLICATES _nodl_search_prefixes)

foreach(prefix IN LISTS _nodl_search_prefixes)
  list(APPEND _nodl_pythonpath_dirs "${prefix}/${_nodl_python_install_dir}")
endforeach()
list(REMOVE_DUPLICATES _nodl_pythonpath_dirs)
string(JOIN ":" _nodl_generator_py_extra_pythonpath ${_nodl_pythonpath_dirs})

include("${CMAKE_CURRENT_LIST_DIR}/nodl_generate_py.cmake")
